# Copy to .env for local development.
# DATABASE_URL points at SQLite in development.
# Production should use a managed database URL (e.g. PostgreSQL) without code changes to Presentation.

DATABASE_URL="file:./prisma/dev.db"

# Explicit principal admin user id (must match a User with role admin).
PRINCIPAL_ADMIN_USER_ID="user-practicantes-001"

# Canonical principal-admin login email (overrides the seed constant).
# ALTANA_PRINCIPAL_ADMIN_EMAIL="altanapromotorapracticantes@gmail.com"

# Set cookies with Secure only on HTTPS. Use "false" for local Docker over HTTP.
# COOKIE_SECURE="false"

# Development-only password used when seeding the principal admin Credential.
# NEVER commit a production password. Override locally / in deployment secrets.
ADMIN_SEED_PASSWORD="DevOnly-ChangeMe!"

# Real first administrator (optional). When set, db:seed creates/updates that user
# with role admin and a hashed credential. Password is never stored in source code.
# PRINCIPAL_ADMIN_USER_ID must match the bootstrapped user id for password login.
# ALTANA_INITIAL_ADMIN_EMAIL=""
# ALTANA_INITIAL_ADMIN_PASSWORD=""
# Set to "true" once to replace an existing dev credential hash (remove after use).
# ALTANA_INITIAL_ADMIN_APPLY_PASSWORD="false"
# ALTANA_INITIAL_ADMIN_FIRST_NAME="Administrador"
# ALTANA_INITIAL_ADMIN_LAST_NAME="ALTANA"

# Optional dev invitation codes for seeded WorkerInvitation rows (non-production).
# WORKER_DEV_CODE_VALID="WORKER1A2B"
# WORKER_DEV_CODE_EXPIRED="EXPIRED1A2"
# WORKER_DEV_CODE_REVOKED="REVOKED1A2"
# WORKER_DEV_CODE_USED="USED0001A2"

# Invitation validity in days (default 30).
# WORKER_INVITATION_TTL_DAYS="30"

# Resend policy (server-side). Defaults: 120 seconds cooldown, 5 resends.
# WORKER_INVITATION_RESEND_COOLDOWN_SECONDS="120"
# WORKER_INVITATION_MAX_RESENDS="5"

# Public site URL used in invitation emails (no trailing slash).
# Development fallback: http://localhost:3000
# APP_URL="http://localhost:3000"

# Google OAuth for internal login. Google proves the mailbox; ALTANA still
# authorizes (principal admin, existing worker, or valid invitation).
# Create credentials in Google Cloud Console and add the redirect URI:
# {APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Extra Gmail accounts that may enter via Google (comma-separated).
# Google Cloud test users are not enough — they must also be listed here.
# ALTANA_GOOGLE_ALLOWED_EMAILS="altanapromotorapracticantes@gmail.com"

# Email delivery. The application depends on the MailSender contract, not a vendor SDK.
# EMAIL_PROVIDER=console   → development simulation
# EMAIL_PROVIDER=smtp      → Gmail/SMTP real delivery (requires app password)
# EMAIL_PROVIDER=resend    → Resend HTTP API
# EMAIL_PROVIDER="gmail"
# After App Passwords are unavailable, connect Gmail from /admin/settings.
# Add this OAuth redirect URI in Google Cloud:
# {APP_URL}/api/admin/mail/google/callback
# GOOGLE_MAIL_REDIRECT_URI="http://localhost:3000/api/admin/mail/google/callback"
# EMAIL_SMTP_HOST="smtp.gmail.com"
# EMAIL_SMTP_PORT="587"
# EMAIL_SMTP_USER="altanapromotorapracticantes@gmail.com"
# EMAIL_SMTP_PASSWORD=""
# EMAIL_FROM="ALTANA PROMOTORA <altanapromotorapracticantes@gmail.com>"
# EMAIL_API_KEY=""
